/node_modules/
/dist/
/src-tauri/target/
/src-tauri/resources/runtime/*
/src-tauri/resources/server/*
/src-tauri/resources/plugins/*
!/src-tauri/resources/runtime/.gitkeep
!/src-tauri/resources/server/.gitkeep
!/src-tauri/resources/plugins/.gitkeep
/src-tauri/crates/box-dsh-context/dsh-box-context/dist/
/src-tauri/crates/box-dsh-context/dsh-box-context/node_modules/
/src-tauri/.build-stamp
# Local debugging / build leftovers: never commit these.
/.e2e-dbg/
/.tmp/
/.bundle-tmp/
.bundle-verify.log
.e2e-*.log
/src-tauri/*.dsh.tar.gz
# ZCode session plans: ephemeral, regenerated every session.
/.zcode/
# Throwaway packaging artefacts.
/dshbox-*.tgz
# Isolated Windows/Linux lifecycle experiments. These roots can contain cloned
# Harness trees and pnpm stores; they are deliberately never source inputs.
/.e2e-config-*/
/.e2e-runtime-*/
/.e2e-*.dsh
# Vite build output (dist is bundled into the desktop binary by Tauri's
# beforeBuildCommand; never edit files under this directory).
/src-tauri/dist/
# Prepare-script content-hash cache: regenerated on demand, never tracked.
/.cache/
