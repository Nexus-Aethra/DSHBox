#!/bin/sh
# PATH entry for the dshbox daemon shipped inside the DSH Box install.
# The deb/rpm bundle deploys the daemon at /usr/lib/dshbox/server/<target>/dshboxd
# (tauri's resource map drops the `resources/` level), so resolve the target
# subdirectory instead of naming it, and point the daemon at the install root
# via DSHBOX_RESOURCE_DIR — the Rust side derives <root>/runtime/<target>/ from
# it and only needs this because a PATH entry carries no exe-relative context.

set -eu

INSTALL_ROOT=/usr/lib/dshbox

for candidate in "$INSTALL_ROOT"/server/*/dshboxd; do
  if [ -x "$candidate" ]; then
    DSHBOX_RESOURCE_DIR="$INSTALL_ROOT"
    export DSHBOX_RESOURCE_DIR
    exec "$candidate" "$@"
  fi
done

echo "dshboxd: bundled daemon is missing; reinstall DSH Box" >&2
exit 1
