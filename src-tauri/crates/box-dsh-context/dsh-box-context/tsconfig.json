{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationDir": "lib/types",
    "outDir": "lib",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src"]
}
