{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dshbox",
  "version": "0.1.0",
  "identifier": "com.nexus-aethra.dshbox",
  "build": {
    "beforeDevCommand": "pnpm runtime:prepare && pnpm server:prepare && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm runtime:prepare && pnpm server:prepare && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "DSH Box", "width": 1024, "height": 760, "minWidth": 640, "minHeight": 560 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/runtime/": "runtime/",
      "resources/server/": "server/"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English", "SimpChinese"]
      }
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
