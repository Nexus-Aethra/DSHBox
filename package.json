{
  "name": "dshbox",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "plugin:build": "node scripts/build-plugin.mjs",
    "server:prepare": "node scripts/prepare-server.mjs",
    "bundle:linux": "DSH_BOX_RUNTIME_TARGET=linux-x64 pnpm plugin:build && pnpm runtime:prepare && pnpm server:prepare && pnpm tauri build --bundles deb,rpm --config src-tauri/tauri.linux.conf.json",
    "bundle:windows": "node scripts/bundle-windows.mjs",
    "bundle:macos": "DSH_BOX_RUNTIME_TARGET=macos-arm64 pnpm plugin:build && pnpm runtime:prepare && pnpm server:prepare && pnpm tauri build --bundles dmg --config src-tauri/tauri.macos.conf.json",
    "desktop:install": "node scripts/install-desktop-entry.mjs",
    "desktop:install:system": "node scripts/install-desktop-entry.mjs --system",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1",
    "vite": "^6.0.5"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
